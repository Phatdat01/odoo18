<odoo>
  <record id="view_popup_demo_wizard_form" model="ir.ui.view">
    <field name="name">popup.demo.wizard.form</field>
    <field name="model">popup.demo.wizard</field>
    <field name="arch" type="xml">
      <form string="Thông tin người dùng">
        <group>
          <field name="name"/>
        </group>
        <footer>
          <button string="Xác nhận" type="object" name="confirm" class="btn-primary"/>
          <button string="Hủy" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
