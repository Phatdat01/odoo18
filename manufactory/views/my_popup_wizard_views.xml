<!-- views/fish_weight_popup_view.xml -->
<odoo>
    <record id="view_fish_weight_popup_form" model="ir.ui.view">
        <field name="name">fish.weight.popup.form</field>
        <field name="model">fish.weight.popup</field>
        <field name="arch" type="xml">
            <form string="Popup Ghi chú">
                <group>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
