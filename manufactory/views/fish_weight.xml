<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Search view -->
    <record id="manufactory_fish_weight_view_search" model="ir.ui.view">
        <field name="name">manufactory.fish_weight.view.search</field>
        <field name="model">manufactory.fish_weight</field>
        <field name="arch" type="xml">
            <search string="Search Opportunities">
                <field name="fish_id"/>
                <field name="fish_type"/>
            </search>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_fish_weight_form" model="ir.ui.view">
        <field name="name">manufactory.fish_weight.form</field>
        <field name="model">manufactory.fish_weight</field>
        <field name="arch" type="xml">
            <form string="Fish Weight">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="fish_id"/>
                            <field name="weight"/>
                        </group>

                        <group>
                            <field name="fish_type"/>
                            <field name="user_name"/>
                        </group>
                    </group>
                </sheet>
                <xpath expr="//sheet" position="inside">
                    <button name="open_popup"
                            string="Open Fish Popup"
                            type="object"
                            class="oe_highlight"/>
                </xpath>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="manufactory_fish_weight_view_tree" model="ir.ui.view">
        <field name="name">manufactory.fish_weight.list</field>
        <field name="model">manufactory.fish_weight</field>
        <field name="arch" type="xml">
            <list string="Channel" editable="bottom">
                <field name="fish_id"/>
                <field name="weight"/>
                <field name="fish_type"/>
                <field name="user_name"/>
            </list>
        </field>
    </record>

    <!-- Windows action -->
    <record id= "action_fish_weight" model="ir.actions.act_window">
        <field name="name">Fish weight</field>
        <field name="res_model">manufactory.fish_weight</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_similing_face">Create your first fish weight</p>
        </field>
    </record>
</odoo>